{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-ai-local-bridge/v1/memory-atom.schema.json",
  "title": "MemoryAtom",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "kind",
    "namespace",
    "memory_space_id",
    "subject",
    "key",
    "content",
    "verification_status",
    "lifecycle_status",
    "sensitivity",
    "confidence",
    "provenance",
    "created_at",
    "updated_at",
    "revision"
  ],
  "properties": {
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "structured_value": {},
    "verification_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "CONFLICT",
        "TOMBSTONED"
      ]
    },
    "sensitivity": {
      "enum": [
        "NORMAL",
        "SENSITIVE",
        "SECRET_PROHIBITED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transaction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "conflict_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiry": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_space_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
