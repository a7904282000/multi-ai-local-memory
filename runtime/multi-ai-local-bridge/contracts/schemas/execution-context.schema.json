{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-ai-local-bridge/v1/execution-context.schema.json",
  "title": "ExecutionContext",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "intermediary_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
