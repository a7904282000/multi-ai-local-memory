{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-ai-local-bridge/v1/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "boundary"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "AUTH_FAILED",
            "FORBIDDEN",
            "POLICY_REJECTED",
            "NOT_FOUND",
            "CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "STORAGE_UNAVAILABLE",
            "STORAGE_FAILURE",
            "BRIDGE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "transaction_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
