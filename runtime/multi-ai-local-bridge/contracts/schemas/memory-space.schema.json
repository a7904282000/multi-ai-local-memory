{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-ai-local-bridge/v1/memory-space.schema.json",
  "title": "MemorySpaceIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space_id",
    "owner_id"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "default": "personal"
    }
  }
}
