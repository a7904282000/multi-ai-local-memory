{
  "manifest_version": 3,
  "name": "Multi-AI Local Memory",
  "version": "0.7.0",
  "description": "Shared local memory for multiple web AI clients.",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*"
      ],
      "js": [
        "src/runtime-core.js",
        "src/site-chatgpt.js",
        "src/site-grok.js",
        "src/content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
