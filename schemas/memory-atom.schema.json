{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-AI Local Memory Atom",
  "type": "object",
  "required": ["category", "fact", "status", "source_type", "source_agent", "last_known_date", "confidence", "mutable", "sensitivity"],
  "properties": {
    "id": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "project": {"type": ["string", "null"]},
    "fact": {"type": "string", "minLength": 1},
    "status": {"enum": ["VERIFIED", "UNVERIFIED", "OBSOLETE", "CONFLICT"]},
    "source_type": {"type": "string", "minLength": 1},
    "source_agent": {"type": "string", "minLength": 1},
    "source_ref": {"type": ["string", "null"]},
    "last_known_date": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "mutable": {"type": "boolean"},
    "sensitivity": {"enum": ["normal", "sensitive", "secret"]},
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
